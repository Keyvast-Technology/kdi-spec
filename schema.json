{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyvast.dev/kdi/descriptor.schema.json",
  "title": "Keyvast Device Interface descriptor",
  "type": "object",
  "required": [
    "kdi",
    "device",
    "caps",
    "cap_gates",
    "errors",
    "host_errors",
    "identity_registers",
    "fastpath_registers",
    "ready_timeout_ms",
    "streams",
    "commands",
    "bindings"
  ],
  "properties": {
    "kdi": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "device": {
      "type": "object",
      "required": [
        "vendor",
        "type",
        "impl_version",
        "compatible"
      ]
    },
    "caps": {
      "type": "object"
    },
    "cap_gates": {
      "type": "object"
    },
    "errors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "retryable"
        ],
        "properties": {
          "retryable": {
            "type": "boolean"
          },
          "doc": {
            "type": "string"
          }
        }
      }
    },
    "host_errors": {
      "type": "object"
    },
    "ready_timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "identity_registers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "access"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "access": {
            "enum": [
              "ro",
              "rw"
            ]
          }
        }
      }
    },
    "fastpath_registers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "access"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "access": {
            "enum": [
              "ro",
              "rw"
            ]
          }
        }
      }
    },
    "streams": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "direction",
              "implemented",
              "frame_format",
              "header",
              "descriptor",
              "kinds",
              "invariants",
              "timebase",
              "max_frame_bytes",
              "wire_layout",
              "registers",
              "reject_tokens",
              "counters"
            ],
            "properties": {
              "implemented": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "direction",
              "implemented",
              "frame_format"
            ],
            "properties": {
              "implemented": {
                "const": false
              }
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "safety"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "public",
              "service",
              "factory"
            ]
          },
          "safety": {
            "enum": [
              "ro",
              "attended",
              "raw",
              "bringup",
              "unsafe"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "object"
    }
  }
}
